#include <stdio.h>

int fila, columna, n, i, j;

int matriz [4][4] = {
    {1, 2, 3, 4},
    {5, 6, 11, 8}, 
    {9, 13, 7, 10}, 
    {14, 15, 16, 17}
};

int main(){
    
    printf("Indique la fila del valor a modificar (Inicia de 0)\n");
    scanf("%d", &fila);
    
    printf("Indique la columna del valor a modificar (Inicia de 0)\n");
    scanf("%d", &columna);
    
    printf("Por que valor lo quiere modificar?\n");
    scanf("%d", &n);
    
    matriz[fila][columna] = n;
    
    for(i=0; i<4; i++){
        for(j=0;j<4;j++){
            printf("%d ", matriz[i][j]);
        }
        printf("\n");
    }
    
    return 0;
}
