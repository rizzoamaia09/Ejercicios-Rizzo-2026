#include <stdio.h>

struct Alumno{
    char nombre[50];
    int edad;
    int anio;
};

int main(){

    struct Alumno alumnos[3];

    for (int i = 0; i < 3; i++){

        printf("\nAlumno %d\n", i + 1);

        printf("Ingrese el nombre: ");
        scanf("%s", alumnos[i].nombre);

        printf("Ingrese la edad: ");
        scanf("%d", &alumnos[i].edad);

        printf("Ingrese el año al que pertenece: ");
        scanf("%d", &alumnos[i].anio);
    }

    printf("\n--- Datos originales ---\n");

    for (int i = 0; i < 3; i++){

        printf("\nAlumno %d:\n", i + 1);
        printf("Nombre: %s\n", alumnos[i].nombre);
        printf("Edad: %d años\n", alumnos[i].edad);
        printf("Año: %d\n", alumnos[i].anio);
    }

    printf("\n--- Modificar datos ---\n");

    for (int i = 0; i < 3; i++){

        printf("\nModificar alumno %d\n", i + 1);

        printf("Ingrese el nuevo nombre: ");
        scanf("%s", alumnos[i].nombre);

        printf("Ingrese la nueva edad: ");
        scanf("%d", &alumnos[i].edad);

        printf("Ingrese el nuevo año: ");
        scanf("%d", &alumnos[i].anio);
    }

    printf("\n--- Datos modificados ---\n");

    for (int i = 0; i < 3; i++){

        printf("\nAlumno %d:\n", i + 1);
        printf("Nombre: %s\n", alumnos[i].nombre);
        printf("Edad: %d años\n", alumnos[i].edad);
        printf("Año: %d\n", alumnos[i].anio);
    }

    return 0;
}
