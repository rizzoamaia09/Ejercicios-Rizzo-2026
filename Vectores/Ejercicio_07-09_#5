#include <stdio.h>

#define TAM 10

int calcularSuma(int datos[], int cantidad){
    int total = 0;

    for (int i = 0; i < cantidad; i++){
        total = total + datos[i];
    }

    return total;
}

int main(){
    
    int datos[TAM];
    int auxiliar;
    int suma;
    float promedio;

    printf("Ingrese %d numeros:\n", TAM);

    for (int i = 0; i < TAM; i++){
        printf("Numero %d: ", i + 1);
        scanf("%d", &datos[i]);
    }

    // Ordenar de mayor a menor
    for (int i = 0; i < TAM; i++){
        for (int j = i + 1; j < TAM; j++){
            if (datos[i] < datos[j]){
                auxiliar = datos[i];
                datos[i] = datos[j];
                datos[j] = auxiliar;
            }
        }
    }

    printf("\nDatos ordenados de mayor a menor:\n");

    for (int i = 0; i < TAM; i++){
        printf("%d ", datos[i]);
    }

    suma = calcularSuma(datos, TAM);
    promedio = (float)suma / TAM;

    printf("\n\nSuma: %d", suma);
    printf("\nPromedio: %.2f\n", promedio);

    return 0;
}
